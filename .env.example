# Copie este arquivo para ".env" e preencha com sua chave.

# Provedor de LLM: "google" (RECOMENDADO - gratuito) | "anthropic" | "openai" | "ollama" (local)
LLM_PROVIDER=google

GOOGLE_API_KEY=coloque_sua_chave_aqui
GOOGLE_MODEL=gemini-flash-lite-latest

# --- Ollama (100% LOCAL - sem chave, sem custo) ---
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Anthropic (Claude, pago) ---
ANTHROPIC_API_KEY=coloque_sua_chave_aqui
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (GPT, pago) ---
OPENAI_API_KEY=coloque_sua_chave_aqui
OPENAI_MODEL=gpt-4o-mini
